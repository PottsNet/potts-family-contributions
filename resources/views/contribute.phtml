                    <?php foreach ($facts as $fact) : ?>
                        <option value="<?= e((string) $fact['key']) ?>"><?= e((string) $fact['summary']) ?></option>
                    <?php endforeach ?>
                </select>
                <div class="form-text">Selecting a fact records a snapshot of its current details so the manager can see exactly what you were commenting on.</div>
