        </div>

        <div class="mb-3">
            <label class="form-label" for="pfc-evidence">Source or evidence <span class="text-muted">(optional)</span></label>
            <textarea class="form-control" id="pfc-evidence" name="evidence" rows="3" maxlength="5000" placeholder="For example: I am in the photograph; family album caption; another dated photograph; newspaper article"></textarea>
        </div>

        <?php if ($allow_attachments) : ?>
            <div class="mb-3">
                <label class="form-label" for="pfc-attachment">Attach supporting evidence <span class="text-muted">(optional)</span></label>
                <input class="form-control" id="pfc-attachment" name="attachment" type="file" accept="application/pdf,image/jpeg,image/png,image/webp">
                <div class="form-text">PDF, JPG, PNG or WEBP, up to <?= e((string) $max_upload_mb) ?> MB. This may be another photograph, document or other evidence.</div>
            </div>
        <?php endif ?>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="pfc-name">Your name</label>
                <input class="form-control" id="pfc-name" name="contributor_name" maxlength="255" value="<?= e($contributor_name) ?>" required>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="pfc-email">Your email</label>
                <input class="form-control" id="pfc-email" name="contributor_email" type="email" maxlength="255" value="<?= e($contributor_email) ?>" required>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="pfc-relationship">How are you connected to this media item or the people shown? <span class="text-muted">(optional)</span></label>
