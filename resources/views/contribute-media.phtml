$return_url = isset($return_url) && (string) $return_url !== '' ? (string) $return_url : $media->url();
?>

<div class="container-xl py-3 potts-family-contributions">
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h3 mb-2">Identify or contribute information about <?= e($media_name) ?></h2>
            <p class="text-muted mb-3">Can you identify a person, place, date, event or object in this media item? You can also provide a correction, story or supporting information.</p>

            <?php
            try {
                foreach ($media->mediaFiles() as $media_file) {
                    if (!$media_file->isExternal()) {
                        echo '<div class="text-center border rounded bg-light p-2 mb-2">';
                        echo $media_file->displayImage(520, 360, 'contain', []);
                        echo '</div>';
                        break;
                    }
                }
            } catch (\Throwable) {
            }
            ?>
        </div>
    </div>

    <form method="post" action="<?= e($action_url) ?>" <?= $allow_attachments ? 'enctype="multipart/form-data"' : '' ?>>
        <?php if (function_exists('csrf_field')) : ?>
            <?= csrf_field() ?>
        <?php endif ?>
        <input type="hidden" name="action" value="submit_media">
        <input type="hidden" name="media_xref" value="<?= e($media->xref()) ?>">
        <?php if ($return_person_xref !== '') : ?>
            <input type="hidden" name="return_person_xref" value="<?= e($return_person_xref) ?>">
        <?php endif ?>

        <div class="mb-3">
            <label class="form-label" for="pfc-category">What would you like to contribute?</label>
            <select class="form-select" id="pfc-category" name="category" required>
                <?php foreach ($categories as $value => $label) : ?>
                    <option value="<?= e($value) ?>" <?= $value === 'identification' ? 'selected' : '' ?>><?= e($label) ?></option>
                <?php endforeach ?>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label" for="pfc-message">Who or what can you identify, correct or add?</label>
            <textarea class="form-control" id="pfc-message" name="message" rows="6" maxlength="10000" required placeholder="For example: The man second from the left is John Smith; this photograph was taken at Warragul in about 1948; or this document belongs to another person."></textarea>
