<?php
/** @var \Fisharebest\Webtrees\Family $family */
/** @var \Fisharebest\Webtrees\Tree $tree */
/** @var string $action_url */
/** @var array<string,string> $categories */
/** @var string $contributor_name */
/** @var string $contributor_email */
/** @var bool $allow_attachments */
/** @var int $max_upload_mb */
/** @var array<int,array{id:string,label:string,summary:string}> $facts */
/** @var array{id:string,record_xref:string,record_type:string,tag:string,label:string,summary:string,gedcom:string}|null $selected_fact */
/** @var string $return_person_xref */
/** @var string $return_url */

$family_name = trim(html_entity_decode(strip_tags($family->fullName()), ENT_QUOTES, 'UTF-8'));
$facts = isset($facts) && is_array($facts) ? $facts : [];
$selected_fact = isset($selected_fact) && is_array($selected_fact) ? $selected_fact : null;
$return_person_xref = isset($return_person_xref) ? (string) $return_person_xref : '';
$return_url = isset($return_url) && (string) $return_url !== '' ? (string) $return_url : $family->url();
?>

<div class="container-xl py-3 potts-family-contributions">
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h3 mb-2">
                <?= $selected_fact !== null ? 'Suggest a correction about ' : 'Contribute information about ' ?><?= e($family_name) ?>
            </h2>
            <?php if ($selected_fact !== null) : ?>
                <p class="text-muted mb-3">You are commenting on this specific family fact or event:</p>
                <div class="alert alert-info mb-0">
                    <strong><?= e((string) $selected_fact['label']) ?></strong><br>
                    <?= e((string) $selected_fact['summary']) ?>
                </div>
            <?php else : ?>
                <p class="text-muted mb-0">Share a correction, marriage or family detail, story, document, photograph or other information about this family.</p>
            <?php endif ?>
        </div>
    </div>

    <form method="post" action="<?= e($action_url) ?>" <?= $allow_attachments ? 'enctype="multipart/form-data"' : '' ?>>
        <?php if (function_exists('csrf_field')) : ?>
            <?= csrf_field() ?>
        <?php endif ?>
        <input type="hidden" name="action" value="submit_family">
        <input type="hidden" name="family_xref" value="<?= e($family->xref()) ?>">
        <?php if ($return_person_xref !== '') : ?>
            <input type="hidden" name="return_person_xref" value="<?= e($return_person_xref) ?>">
        <?php endif ?>

        <?php if ($selected_fact !== null) : ?>
            <input type="hidden" name="fact_id" value="<?= e((string) $selected_fact['id']) ?>">
        <?php elseif ($facts !== []) : ?>
            <div class="mb-3">
                <label class="form-label" for="pfc-family-fact">Is your contribution about a specific family fact or event? <span class="text-muted">(optional)</span></label>
                <select class="form-select" id="pfc-family-fact" name="fact_id">
                    <option value="">No — this is a general contribution about this family</option>
                    <?php foreach ($facts as $fact) : ?>
                        <option value="<?= e((string) $fact['id']) ?>"><?= e((string) $fact['summary']) ?></option>
                    <?php endforeach ?>
                </select>
                <div class="form-text">Selecting a fact records a snapshot of its current details for the manager to review.</div>
            </div>
        <?php endif ?>

        <div class="mb-3">
            <label class="form-label" for="pfc-category">What would you like to contribute?</label>
            <select class="form-select" id="pfc-category" name="category" required>
                <?php foreach ($categories as $value => $label) : ?>
                    <option value="<?= e($value) ?>" <?= $selected_fact !== null && $value === 'correction' ? 'selected' : '' ?>><?= e($label) ?></option>
                <?php endforeach ?>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label" for="pfc-message"><?= $selected_fact !== null ? 'What should be corrected?' : 'Your contribution' ?></label>
            <textarea class="form-control" id="pfc-message" name="message" rows="6" maxlength="10000" required placeholder="<?= $selected_fact !== null ? 'Tell us what is incorrect and what you believe the correct information should be.' : 'Tell us what you know about this family, relationship, marriage, children, residence, story or record.' ?>"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label" for="pfc-evidence">Source or evidence <span class="text-muted">(optional)</span></label>
            <textarea class="form-control" id="pfc-evidence" name="evidence" rows="3" maxlength="5000" placeholder="For example: marriage certificate, newspaper notice, family Bible, URL or archive reference"></textarea>
        </div>

        <?php if ($allow_attachments) : ?>
            <div class="mb-3">
                <label class="form-label" for="pfc-attachment">Attach a document or photograph <span class="text-muted">(optional)</span></label>
                <input class="form-control" id="pfc-attachment" name="attachment" type="file" accept="application/pdf,image/jpeg,image/png,image/webp">
                <div class="form-text">PDF, JPG, PNG or WEBP, up to <?= e((string) $max_upload_mb) ?> MB. The file is held privately until it is reviewed.</div>
            </div>
        <?php endif ?>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="pfc-name">Your name</label>
                <input class="form-control" id="pfc-name" name="contributor_name" maxlength="255" value="<?= e($contributor_name) ?>" required>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="pfc-email">Your email</label>
                <input class="form-control" id="pfc-email" name="contributor_email" type="email" maxlength="255" value="<?= e($contributor_email) ?>" required>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="pfc-relationship">How are you connected to this family? <span class="text-muted">(optional)</span></label>
            <input class="form-control" id="pfc-relationship" name="relationship" maxlength="255" placeholder="For example: granddaughter, cousin, descendant, local historian">
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="pfc-contact" name="contact_ok" value="1" checked>
            <label class="form-check-label" for="pfc-contact">The family tree manager may contact me about this contribution.</label>
        </div>

        <div class="d-none" aria-hidden="true">
            <label for="pfc-website">Website</label>
            <input id="pfc-website" name="website" tabindex="-1" autocomplete="off">
        </div>

        <div class="alert alert-light border small">
            Nothing is added to the family tree automatically. Your contribution and any attachment will be reviewed first.
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-primary" type="submit"><?= $selected_fact !== null ? 'Send correction suggestion' : 'Send family contribution' ?></button>
            <a class="btn btn-outline-secondary" href="<?= e($return_url) ?>"><?= $return_person_xref !== '' ? 'Back to person' : 'Back to family' ?></a>
        </div>
    </form>
</div>

<?php if ($selected_fact === null && $facts !== []) : ?>
<script>
(function () {
    const fact = document.getElementById('pfc-family-fact');
    const category = document.getElementById('pfc-category');
    if (!fact || !category) return;
    fact.addEventListener('change', function () {
        if (fact.value !== '') category.value = 'correction';
    });
})();
</script>
<?php endif ?>
